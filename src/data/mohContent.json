    "id": "moh-103",
    "titleAr": "قائمة العناية اليومية بالجرح والغرز",
    "type": "checklist",
    "categoryAr": "الجراحة العامة",
    "codes": [
      "47562",
      "44970"
    ],
    "bodyAr": "خطوات يومية للعناية بالجرح حتى يلتئم.",
    "checklistAr": [
      "حافظ على الجرح نظيفاً وجافاً خلال أول 24 إلى 48 ساعة",
